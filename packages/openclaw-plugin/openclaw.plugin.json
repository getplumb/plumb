{
  "id": "plumb",
  "name": "Plumb Memory",
  "version": "0.4.24-terra.1-e039",
  "description": "Auto-ingest and memory injection for OpenClaw",
  "kind": "memory",
  "main": "dist/index.js",
  "contracts": {
    "tools": [
      "plumb_remember",
      "plumb_search",
      "plumb_wiki_read",
      "plumb_wiki_search",
      "plumb_wiki_list",
      "plumb_wiki_links",
      "plumb_wiki_queue_edit"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "dbPath": {
        "type": "string",
        "description": "Path to the SQLite database file. Defaults to ~/.plumb/memory.db"
      },
      "userId": {
        "type": "string",
        "description": "User ID for scoping memory. Defaults to 'default'"
      },
      "shadowMode": {
        "type": "boolean",
        "description": "If true, retrieves memory context but does not inject it into prompts"
      },
      "queryPort": {
        "type": "number",
        "description": "Port for the query server. Defaults to 18791"
      },
      "wikiMode": {
        "type": "string",
        "enum": [
          "v1",
          "v2",
          "v2-shadow"
        ],
        "description": "Wiki injection mode. Defaults to v1."
      },
      "wikiRoot": {
        "type": "string",
        "description": "Path to wiki markdown root. Defaults to ~/.plumb/wiki"
      },
      "wikiDbPath": {
        "type": "string",
        "description": "Path to wiki SQLite database. Defaults to ~/.plumb/wiki.db"
      },
      "wikiInjectionTelemetry": {
        "type": "boolean",
        "description": "Emit local wiki injection telemetry to plugin logs."
      },
      "contextualRetrieval": {
        "type": "object",
        "additionalProperties": false,
        "description": "E017 opt-in contextual wiki retrieval. Defaults to mode=off.",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "off",
              "shadow",
              "active"
            ],
            "default": "off"
          },
          "model": {
            "type": "string",
            "default": "Xenova/bge-small-en-v1.5"
          },
          "parentTokenBudgets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "default": [
              360,
              260,
              100,
              50,
              25
            ]
          },
          "maxParentTokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 900
          }
        }
      }
    }
  },
  "uiHints": {
    "dbPath": {
      "label": "Database Path",
      "placeholder": "~/.plumb/memory.db"
    },
    "userId": {
      "label": "User ID",
      "placeholder": "default"
    },
    "shadowMode": {
      "label": "Shadow Mode (inject disabled)"
    },
    "queryPort": {
      "label": "Query Server Port",
      "placeholder": "18791"
    },
    "contextualRetrieval": {
      "label": "Contextual Wiki Retrieval"
    }
  }
}
